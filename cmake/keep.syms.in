# names to exclude
hs_misc_alloc
hs_misc_free
hs_free_scratch
hs_stream_alloc
hs_stream_free
hs_scratch_alloc
hs_scratch_free
hs_database_alloc
hs_database_free
^_
# Shared lookup tables used across FAT runtime variants
mmbit_keyshift_lut
mmbit_maxlevel_direct_lut
mmbit_maxlevel_from_keyshift_lut
mmbit_root_offset_from_level
# Windows PE position-independent references for shared mmbit tables
^\.refptr\.mmbit
